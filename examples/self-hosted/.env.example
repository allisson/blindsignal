# Copy to .env, fill in, and keep it readable by you only: chmod 600 .env (ADR 0032).

# The public name of this host; Caddy gets its certificate from Let's Encrypt.
BLINDSIGNAL_DOMAIN=signal.example.com
# The web origins of your applications, comma-separated.
BLINDSIGNAL_ALLOWED_ORIGINS=https://app.example.com
# Letters and digits only, since it goes into a URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional: STUN servers, and a TURN server (docs/turn-operations.md).
# BLINDSIGNAL_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]}]
# BLINDSIGNAL_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# BLINDSIGNAL_TURN_SECRET=

# Any other BLINDSIGNAL_* variable of apps/server/README.md can be set here too.
