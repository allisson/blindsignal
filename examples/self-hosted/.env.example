# Copy to .env, fill in, and keep it readable by you only: chmod 600 .env (ADR 0032).

# The public name of this host; Caddy gets its certificate from Let's Encrypt.
BLINDSIGNAL_DOMAIN=signal.example.com
# The web origins of your applications, comma-separated.
BLINDSIGNAL_ALLOWED_ORIGINS=https://app.example.com
# Letters and digits only, since it goes into a URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional: STUN servers.
# BLINDSIGNAL_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]}]
# Optional: the Coturn of the turn profile on this host (docs/vps.md), or one elsewhere
# (docs/turn-operations.md). The secret: openssl rand -base64 48
# BLINDSIGNAL_TURN_URLS=turn:signal.example.com:3478?transport=udp,turn:signal.example.com:3478?transport=tcp,turns:signal.example.com:5349?transport=tcp
# BLINDSIGNAL_TURN_SECRET=
# With the turn profile: this host's public addresses, space-separated, which the relay must never
# reach (docs/vps.md): curl -4 https://ifconfig.co, and curl -6 if it has IPv6.
# BLINDSIGNAL_TURN_PUBLIC_IP=203.0.113.10

# Logs with a client IP may stay 14 days at most, and Docker keeps them until the container is
# removed: warn writes no client IP (docs/self-hosted.md).
# BLINDSIGNAL_LOG_LEVEL=warn

# Any other BLINDSIGNAL_* variable of apps/server/README.md can be set here too.
